# Copy this file to .env and fill in real values. Never commit .env.
# Every variable below is actually read by the live app (config.py, app.py, routes/materials_routes.py).

# --- Flask core ---
FLASK_DEBUG=False
# Long, random value in production. The app currently falls back to an insecure
# hardcoded default if this is unset -- always set it for any non-local run.
SECRET_KEY=change-me-to-a-long-random-value
PORT=5000

# --- Database ---
# Postgres in production, or leave unset to fall back to a local sqlite file.
DATABASE_URL=postgresql://user:password@host:port/dbname

# --- AI / search integrations ---
OPENROUTER_API_KEY=
YOUTUBE_API_KEY=
GOOGLE_CUSTOM_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=

# --- Cloudinary (study material file storage) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Outgoing email (password reset, notifications) ---
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=noreply@nelavista.com

# --- Live meeting (Agora.io, free tier) ---
# App ID from an Agora Testing Mode project (console.agora.io) -- not secret, it's meant
# to be visible in client-side JS, but kept here for easy rotation like everything else.
AGORA_APP_ID=
