# Copy this file to .env and fill in real values. Never commit .env.
# Every variable below is read by the live app -- config.py, logging_config.py, database.py,
# app/__init__.py, and the route modules. Nothing here is aspirational: an env var that no
# code reads does not belong in this file.

# --- Flask core ---
FLASK_DEBUG=False
# REQUIRED for any non-debug run. config.py refuses to start if this is unset rather than
# falling back to a guessable default; a hardcoded dev value is used only when FLASK_DEBUG=True.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-value
PORT=5000
# 'production' (default when FLASK_DEBUG is false) or 'development'. Controls things
# that must never silently relax on a misconfigured deploy -- see config.py.
ENVIRONMENT=production
# Support/contact address shown in the site footer, Privacy Policy, and Terms of
# Service -- set this to a real, monitored inbox rather than a personal address.
SUPPORT_EMAIL=support@nelavista.com
# Comma-separated list of origins allowed to open a Socket.IO connection (live classes,
# community chat). Never leave this as "*" in production -- see extensions.py/events.py.
SOCKETIO_CORS_ORIGINS=https://nelavista.com
# Forces the session cookie's Secure flag. Unset, it defaults to True for any non-debug run
# and False only when FLASK_DEBUG=True (plain-HTTP local dev) -- so a real HTTPS deploy needs
# no value here. Set it explicitly only to override that.
SESSION_COOKIE_SECURE=True
# How long a session stays valid before the user must log in again, in days. Default 7.
PERMANENT_SESSION_LIFETIME_DAYS=7

# --- Database ---
# Postgres in production, or leave unset to fall back to a local sqlite file.
# IMPORTANT: if this is set to a real (non-sqlite) database and it fails to connect at
# startup, the app now refuses to boot rather than silently falling back to an empty
# local SQLite file -- see database.py's init_database().
DATABASE_URL=postgresql://user:password@host:port/dbname
# Set to 1 to skip init_database() at startup (its create_all()-and-stamp step). Intended only
# for processes that import the app purely to obtain it -- `flask db upgrade`, and maintenance/
# backfill scripts -- where importing app/__init__.py would otherwise touch the database before
# the migration does. Never set it for the web process itself (Procfile/gunicorn).
# tests/conftest.py sets it so a test run can never connect to whatever DATABASE_URL points at.
SKIP_DB_INIT=

# --- Redis (rate limiting + Socket.IO multi-worker support) ---
# Required before running more than one gunicorn worker or more than one dyno/instance --
# without it, rate limits and live-class/chat state are only correct within a single
# worker process. Safe to leave unset for today's single-worker deployment; see
# extensions.py and app.py's create_app().
REDIS_URL=

# --- AI / search integrations ---
OPENROUTER_API_KEY=
YOUTUBE_API_KEY=
# Optional second YouTube Data API key from a *separate* Google Cloud project. YouTube's
# search.list quota (100 queries/day on the default tier) is per-project, not per-application,
# so a second project gets its own separate allowance. Unset is a complete no-op -- identical
# behavior to a single key. See config.py / services/youtube_service.py.
YOUTUBE_API_KEY_2=
# Optional. Raises GitHub's public REST API limit from 60/hr to 5000/hr, shared across every
# student's project review on this deploy (services/link_fetch_service.py). A fine-grained
# token with no scopes (public read-only) is enough. Unset is a no-op.
GITHUB_TOKEN=
# PDF material search fallback (services/google_search_service.py). Google Custom
# Search is permanently closed to new customers -- replaced with Tavily, which has
# a genuine recurring free tier (1,000 credits/month). Get a key at app.tavily.com.
TAVILY_API_KEY=

# --- Cloudinary (study material file storage) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Outgoing email (password reset, email verification) ---
# REQUIRED in production -- routes/auth_routes.py's forgot-password and email-
# verification flows cannot send mail without MAIL_USERNAME/MAIL_PASSWORD set. Left
# unset, the app now logs a clear startup warning (app.py) and every send attempt fails
# with a specific "Email is not configured" server-log entry instead of a generic SMTP
# error -- users still only ever see a safe, generic message.
#
# Default here is Gmail SMTP, which works but has real limits worth knowing before
# relying on it for production password-reset/verification email:
#   - Requires a Google Account with 2-Step Verification turned on, and an "App
#     Password" (myaccount.google.com/apppasswords) as MAIL_PASSWORD -- your normal
#     Gmail password will fail with "534 5.7.9 Application-specific password required".
#   - Gmail enforces a ~500 messages/day sending cap and can silently rate-limit or
#     flag an account that sends a burst of near-identical templated emails.
#   - For a real production deploy, a transactional email provider (SendGrid, Mailgun,
#     Postmark, Resend, Amazon SES, etc.) is more reliable -- most offer an SMTP relay
#     you can drop into MAIL_SERVER/MAIL_PORT/MAIL_USERNAME/MAIL_PASSWORD below with no
#     code changes, since routes/auth_routes.py only talks to whatever SMTP server is
#     configured, never to Gmail specifically.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=
MAIL_PASSWORD=
# Must be a real, deliverable sender address your MAIL_SERVER is authorized to send as --
# for Gmail SMTP this should match MAIL_USERNAME (Gmail rejects/overrides a mismatched
# From address); a dedicated provider can usually send as a verified custom domain address.
MAIL_DEFAULT_SENDER=noreply@nelavista.com

# --- Live meeting (Agora.io, free tier) ---
# App ID from an Agora Testing Mode project (console.agora.io) -- not secret, it's meant
# to be visible in client-side JS, but kept here for easy rotation like everything else.
AGORA_APP_ID=

# --- "Sign in with Google" (routes/auth_routes.py) ---
# Both required to enable the feature -- create an OAuth 2.0 Client ID at
# console.cloud.google.com (APIs & Services > Credentials), type "Web application", and
# add <your-domain>/auth/google/callback (and http://localhost:5000/auth/google/callback
# for local dev) as an authorized redirect URI. Left unset, the Google button is simply
# hidden and /auth/google redirects back with a flash error instead of crashing.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Error monitoring (optional) ---
# sentry-sdk is already a dependency and logging_config.py initializes it the moment this is
# set -- no code change needed. ERROR-and-above records go to Sentry; structured logs already
# go to stdout regardless, so leaving this unset still leaves the app observable.
SENTRY_DSN=
# Fraction of requests traced for latency data, 0.0-1.0. Default 0.0 (errors only).
SENTRY_TRACES_SAMPLE_RATE=0.0
