# Editor / OS
.vscode/
.idea/
*.swp
Thumbs.db
.DS_Store

# Claude Code local tooling config (not project code)
.claude/

# Freebuff agent tooling (local session metadata, not project code)
.freebuff/

# Node (no frontend toolchain lives here today; this guards a stray install)
node_modules/

# Large stray downloads / installers (should never be committed)
*.exe

# Loose scratch/course-material PDFs accidentally dropped at repo root.
# app/static/materials/ content and data/cbt questions stay tracked on purpose:
# the seed scripts and CBT bank reads depend on them.
/*.pdf
/100 level pdfs/
/SC COURSE CODE

# Local run output
backfill_logs/
pytest_single.txt
*.log

# --- Monorepo / V2 (added in Phase 3 prep) ---
# JS/TS workspace
.turbo/
node_modules/
dist/
# NOTE: do NOT ignore a bare `build/` — it would also exclude docs/build/ (the build prompts).
/apps/*/build/
/packages/*/build/
coverage/
*.tsbuildinfo
.pnpm-store/

# Expo / React Native (generated native projects; config lives in app.json/eas.json)
.expo/
.eas/
apps/mobile/ios/
apps/mobile/android/
apps/mobile/web-build/

# Python tooling (V2 api)
.venv/
.uv/
.ruff_cache/
.mypy_cache/
.pytest_cache/

# Test / e2e artifacts
test-results/
playwright-report/

# Local env files at any depth (.env.example is NOT matched here)
.env.local
.env.*.local
apps/*/.env
apps/*/.env.local

# OpenAPI export used to generate packages/api-client (regenerated in CI)
openapi.json

# V1 data exports contain real student data; never commit them
v1-export.json
*-v1-export.json

# Local secrets pulled from a provider, never committed
*.p8
*.p12
*.keystore
*.jks
*.mobileprovision
