[TEMPLATE]
# Copy to .env.local (gitignored) for local work. Never put secrets here:
# everything VITE_* is compiled into the public bundle.

# Where the dev server proxies /api. Defaults to http://localhost:8000.
VITE_API_BASE_URL=http://localhost:8000

# API path version (distinct from the product version — ADR-0010).
VITE_API_VERSION=v1

# Ops analytics and error tracking (PostHog). Public project key; unset is a
# no-op. Use the same project as the web app so one dashboard sees both.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# The public web origin, used by the "Open public page" link on Public site.
VITE_PUBLIC_SITE_URL=https://nelavista.com
