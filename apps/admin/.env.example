[TEMPLATE]
# Copy to .env.local (gitignored) for local work. Never put secrets here:
# everything VITE_* is compiled into the public bundle.

# Where the dev server proxies /api. Defaults to http://localhost:8000.
VITE_API_BASE_URL=http://localhost:8000

# API path version (distinct from the product version — ADR-0010).
VITE_API_VERSION=v1
