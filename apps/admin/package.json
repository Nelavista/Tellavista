{
  "name": "@nelavista/admin",
  "version": "0.0.1",
  "private": true,
  "description": "Nelavista V2 internal ops tools (role-gated). Separate app from the student web app.",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5174",
