# Copy this file to apps/api/.env.local for local work. Never put real secrets here.
# Real dev/prod values live ONLY in the hosting platform's environment settings.

# --- Core ---
APP_ENV=local                       # local | dev | prod  (drives everything)
API_VERSION=v1                      # path version; must exist in packages/config/versions.json
SECRET_KEY=change-me-to-a-long-random-value
# Comma-separated. Local dev origins + the environment's own frontends.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
# Where emailed links (verify/reset) point. Prod uses https://nelavista.com.
WEB_BASE_URL=http://localhost:5173

# --- Database (local Docker Compose in the example below) ---
DATABASE_URL=postgresql://nelavista:nelavista@localhost:5432/nelavista

# --- Redis (ARQ queue + cache) ---
REDIS_URL=redis://localhost:6379/0

# --- Email ---
# smtp = Mailpit locally, or any SMTP relay with AUTH.
# sendhiiv = Sendhiiv's HTTP API (no outbound SMTP port; needed on Render free).
# There is no Sendhiiv test-key mode: use a live key and set EMAIL_REDIRECT_TO
# in DEV so preview mail funnels to one inbox.
EMAIL_PROVIDER=smtp
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USE_TLS=false
MAIL_FROM=noreply@nelavista.local
MAIL_USERNAME=
MAIL_PASSWORD=
# Non-production only. Every message goes here; the real recipient stays in the
# subject. Ignored when APP_ENV=prod.
EMAIL_REDIRECT_TO=
# Sendhiiv only. Leave SENDHIIV_FROM empty to use the shared sender until the
# domain is verified.
SENDHIIV_API_KEY=
SENDHIIV_API_URL=https://api.sendhiiv.com/api/v1/messages
SENDHIIV_FROM=

# --- Integrations (all optional locally; the app degrades cleanly when unset) ---
OPENROUTER_API_KEY=
# Model used for Ask Nelavista when a key is set; unset falls back to the default.
OPENROUTER_MODEL=openai/gpt-4o-mini
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
POSTHOG_API_KEY=
# Expo push endpoint (https://exp.host/--/api/v2/push/send). Unset = in-app only.
PUSH_ENDPOINT=

# --- Feature flags (unset = off, except where a default is noted) ---
# Anything half-built merges behind its flag, so an unfinished area is a 404.
FLAG_SKILLS_JOURNEY=
FLAG_MANAGED_WORKFORCE=
FLAG_LEDGER=
FLAG_ACADEMIA_CONNECT=
FLAG_TALENT_PROFILE=
FLAG_EXTERNAL_OPPORTUNITIES=
