{
  "cli": { "version": ">= 12.0.0", "appVersionSource": "local" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": { "APP_VARIANT": "development", "API_BASE_URL": "https://api-dev.nelavista.com" }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": { "APP_VARIANT": "preview", "API_BASE_URL": "https://api-dev.nelavista.com" }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "env": { "APP_VARIANT": "production", "API_BASE_URL": "https://api.nelavista.com" }
    }
  },
  "submit": {
    "production": {}
  }
}
