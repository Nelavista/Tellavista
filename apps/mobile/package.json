{
  "name": "@nelavista/mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo/AppEntry.js",
  "description": "Nelavista V2 mobile app — one Expo (React Native) codebase for iOS and Android (ADR-0001).",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "build:dev": "eas build --profile development",
    "build:preview": "eas build --profile preview",
    "build:prod": "eas build --profile production",
    "update": "eas update --branch production",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@nelavista/api-client": "workspace:*",
    "@nelavista/config": "workspace:*",
    "@nelavista/contracts": "workspace:*",
    "@nelavista/design-tokens": "workspace:*",
    "expo": "~52.0.0",
    "expo-auth-session": "~6.0.0",
    "expo-constants": "~17.0.0",
    "expo-crypto": "~14.0.0",
    "expo-notifications": "~0.29.0",
    "expo-secure-store": "~14.0.0",
    "expo-sqlite": "~15.0.0",
    "expo-status-bar": "~2.0.0",
    "expo-updates": "~0.26.0",
    "expo-web-browser": "~14.0.0",
    "react": "18.3.1",
    "react-native": "0.76.5"
  },
  "devDependencies": {
    "@types/react": "~18.3.12",
    "typescript": "~5.3.3",
    "vitest": "^2.1.8"
  }
}
