{
  "name": "nelavista",
  "private": true,
  "version": "0.0.0",
  "description": "Nelavista monorepo — V1 (Flask, repo root) + V2 (apps/*, packages/*).",
  "packageManager": "pnpm@9.12.3",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate:api-client": "pnpm --filter @nelavista/api-client generate"
  },
  "devDependencies": {
    "eslint": "^9.15.0",
    "prettier": "^3.3.3",
    "turbo": "^2.3.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.16.0"
  }
}
